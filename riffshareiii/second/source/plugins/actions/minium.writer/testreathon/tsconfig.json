{
	"compilerOptions": {
		"target": "es2018",
		"outFile": "testrun.js",
		"strictNullChecks": true,
		"alwaysStrict": true,
		"esModuleInterop": true,
		"noResolve": false,
		"noImplicitAny": false,
		"removeComments": true,
		"preserveConstEnums": true,
		"sourceMap": false,
		"experimentalDecorators": true,
		"isolatedModules": false,
		"module": "AMD",
		"lib": [
			"dom",
			"es2019",
			"es5"
		],
		"declaration": false
	},
	"files": [
		"test.ts"
	]
}